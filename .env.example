# 後でAI候補抽出に利用予定
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra

# 無料のローカルAI（Ollamaを起動し、qwen3:4bを導入すると優先使用）
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b

# Whisper: CPUでは small / cpu / int8 が標準です
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# YouTube投稿（Google CloudでYouTube Data API v3とOAuthクライアントを作成）
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://127.0.0.1:8765/api/youtube/oauth/callback
